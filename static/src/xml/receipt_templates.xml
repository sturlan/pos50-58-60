<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="InvoiceReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
            <t t-if="receipt.invoice">
                <div class="pos-receipt-title">
                    INVOICE
                </div>
                <div class="pos-receipt-invoice-number">
                    Invoice Number: <t t-esc="receipt.invoice.number"/>
                </div>
                <div class="pos-receipt-invoice-date">
                    Date: <t t-esc="receipt.invoice.date"/>
                </div>
                <!-- Add more invoice-specific fields here -->
            </t>
        </xpath>
    </t>
</templates> 